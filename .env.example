# ---- Общий секрет между WSL и VPS (любая длинная случайная строка) ----
# сгенерировать: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TGBRIDGE_TOKEN=change-me

# ================= только VPS (server) =================
# токен бота от @BotFather
TGBRIDGE_BOT_TOKEN=
# твой Telegram user id (узнать: команда /id у бота или @userinfobot). Через запятую можно несколько.
TGBRIDGE_ALLOWED_USER_IDS=
# где хранить очередь
TGBRIDGE_DB_PATH=/home/oneal/tgbridge/tgbridge.sqlite3
TGBRIDGE_HOST=0.0.0.0
TGBRIDGE_PORT=8080

# ================= только WSL (agent + tgnotify) =================
# адрес VPS со статическим ip
TGBRIDGE_SERVER_URL=http://VPS_IP:8080
# бинарь claude code и рабочая папка для промптов
TGBRIDGE_CLAUDE_BIN=claude
TGBRIDGE_WORKDIR=/home/oneal
# лимит времени на один промпт, сек
TGBRIDGE_PROMPT_TIMEOUT=300
