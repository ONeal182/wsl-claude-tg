# VPS. Установка:
#   mkdir -p ~/.config/systemd/user && cp deploy/tgbridge-server.service ~/.config/systemd/user/
#   loginctl enable-linger $USER      # чтобы жил без активной сессии
#   systemctl --user daemon-reload && systemctl --user enable --now tgbridge-server
#   journalctl --user -u tgbridge-server -f
[Unit]
Description=tgbridge server (Telegram bot + HTTP API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tgbridge
EnvironmentFile=%h/tgbridge/.env
ExecStart=%h/tgbridge/.venv/bin/tgbridge-server
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
