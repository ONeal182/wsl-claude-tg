# WSL (домашняя машина). Требует systemd=true в /etc/wsl.conf. Установка:
#   mkdir -p ~/.config/systemd/user && cp deploy/tgbridge-agent.service ~/.config/systemd/user/
#   loginctl enable-linger $USER      # чтобы агент стартовал вместе с WSL, без входа в сессию
#   systemctl --user daemon-reload && systemctl --user enable --now tgbridge-agent
#   journalctl --user -u tgbridge-agent -f
[Unit]
Description=tgbridge agent (pulls prompts from VPS, runs claude -p)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/tgbridge
EnvironmentFile=%h/tgbridge/.env
ExecStart=%h/tgbridge/.venv/bin/tgbridge-agent
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
