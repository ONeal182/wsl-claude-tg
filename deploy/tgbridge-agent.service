# WSL (домашняя машина) — user-юнит. Требует systemd=true в /etc/wsl.conf.
# Ставится скриптом deploy/wsl-setup.sh. Управление:
#   systemctl --user status tgbridge-agent
#   journalctl --user -u tgbridge-agent -f
[Unit]
Description=tgbridge agent (pulls prompts from VPS via tunnel, runs claude -p)
After=network-online.target tgbridge-tunnel.service
Wants=network-online.target tgbridge-tunnel.service

[Service]
Type=simple
WorkingDirectory=%h/tgbridge
EnvironmentFile=%h/tgbridge/.env
ExecStart=%h/tgbridge/.venv/bin/tgbridge-agent
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
